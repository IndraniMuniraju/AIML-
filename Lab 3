import pandas as pd

# Load the dataset
data = pd.read_csv("workload_data.csv")

print("Dataset:\n")
print(data)

# Initialize the hypothesis
hypothesis = None

print("\nProcessing Training Examples...\n")

# Iterate through each row
for index, row in data.iterrows():

    # Check only positive examples
    if row["High-Performance Edge"] == "Yes":

        # Remove target column
        instance = row[:-1].tolist()

        # First positive example
        if hypothesis is None:
            hypothesis = instance.copy()

        else:
            # Compare each attribute
            for i in range(len(hypothesis)):
                if hypothesis[i] != instance[i]:
                    hypothesis[i] = "?"

    # Print hypothesis after every row
    print(f"After Row {index + 1}: {hypothesis}")

# Final hypothesis
print("\nFinal Specific Hypothesis:")
print(hypothesis)
